[core]
	editor = vim
	ignorecase = false
	excludesfile = ~/.config/git/ignore
	pager = delta

[push]
	default = simple
	autoSetupRemote = true

[color]
	status = auto
	diff = auto
	branch = auto

[ghq]
	root = ~/.ghq

[credential]
	# Clear helpers inherited from the system Git configuration.
	helper =
	helper = !~/scripts/git-credential-helper.sh

# Personal name/email live in ~/.gitconfig.local (not committed)
[include]
	path = ~/.gitconfig.local
[credential "https://dev.azure.com"]
	useHttpPath = true

[pull]
	rebase = true
[credential "azrepos:org/heineken"]
	username = kien.mac@niteco.se
	azureAuthority = https://login.microsoftonline.com/66e853de-ece3-44dd-9d66-ee6bdf4159d4
[credential "azrepos:org/NitecoGroup"]
	username = kien.mac@niteco.se
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[delta]
  line-numbers = true
  side-by-side = true
